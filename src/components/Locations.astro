---
import { t, type Locale, VOICE_ASSISTANT_PHONE, VOICE_ASSISTANT_WHATSAPP, telHref, waHref } from "../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale);

function lp(target: string): string {
  if (locale === "ru") return target;
  return `/${locale}${target === "/" ? "" : target}`;
}

// A 2GIS link per address (the client asked for links like on allergoscreen.kz, no embedded map).
// Queries follow the order of `addresses` in ui.ts.
const gisCity = { astana: "astana", almaty: "almaty", karaganda: "karaganda", temirtau: "temirtau", shymkent: "shymkent" };
const gisQueries = {
  astana: ["Байтурсынова 6", "Ракымова 22"],
  almaty: ["Кабанбай Батыра 111", "Райымбека 540/7"],
  karaganda: ["Степной-2 18/1"],
  temirtau: ["Мира 114"],
  shymkent: ["Акпан батыра 42", "Кабанбай батыра 26"],
};
// Exact 2GIS cards where the client sent one (beats a search by address).
const gisExact: Record<string, string> = {
  "almaty:1": "https://2gis.kz/almaty/geo/9430047375186978", // Райымбека 540/7, LB Clinic — link from the client's docx 21.11
};
const gisHref = (slug: string, i: number) => {
  if (gisExact[`${slug}:${i}`]) return gisExact[`${slug}:${i}`];
  const q = gisQueries[slug as keyof typeof gisQueries]?.[i];
  const city = gisCity[slug as keyof typeof gisCity];
  return q && city ? `https://2gis.kz/${city}/search/${encodeURIComponent(q)}` : undefined;
};

// Branch facade photos per city, two sizes for retina.
const cityPhoto = {
  astana: { src: "/photos/astana-baitursynova-600.jpg", src2x: "/photos/astana-baitursynova-1200.jpg", alt: "Пункт забора в Астане, ул. Ахмета Байтурсынова, 6" },
  almaty: { src: "/photos/almaty-kabanbay-600.jpg", src2x: "/photos/almaty-kabanbay-1200.jpg", alt: "Пункт забора в Алматы, ул. Кабанбай Батыра, 111 (здание Neuromed)" },
  karaganda: { src: "/photos/karaganda-stepnoy-600.jpg", src2x: "/photos/karaganda-stepnoy-1200.jpg", alt: "Пункт забора в Караганде, мкр. Степной-2, 18/1" },
  temirtau: { src: "/photos/temirtau-mira-600.jpg", src2x: "/photos/temirtau-mira-1200.jpg", alt: "Пункт забора в Темиртау, пр. Мира, 114" },
  shymkent: { src: "/photos/shymkent-akpan-600.jpg", src2x: "/photos/shymkent-akpan-1200.jpg", alt: "Пункт забора в Шымкенте, ул. Акпан батыра, 42" },
};
---

<!-- HERO -->
<section class="bg-mist border-b border-rule">
  <div class="container-x py-12 lg:py-16">
    <a href={lp("/")} class="text-[13px] text-ink-400 hover:text-brand-700 inline-flex items-center gap-1 mb-6">{s.common.back_home}</a>
    <h1 class="mb-5">{s.locations_page.title}</h1>
    <p class="lede max-w-prose">{s.locations_preview.lede}</p>
  </div>
</section>

<!-- LOCATIONS DETAILED CARDS -->
<section class="container-x py-12 lg:py-20 space-y-8 lg:space-y-10">
  {
    s.locations_preview.cities.map((c) => {
      const photo = cityPhoto[c.slug as keyof typeof cityPhoto];
      return (
        <div id={c.slug} class="reveal scroll-mt-32">
          <div class="grid lg:grid-cols-[1.4fr_1fr] bg-white rounded-3xl border border-rule shadow-card overflow-hidden">
            <!-- Text -->
            <div class="p-7 sm:p-8 lg:p-10">
              <h2 class="mb-1">{c.city}</h2>
              <div class="text-brand-700 text-[14px] font-semibold mb-6">{c.hours}</div>

              <div class="grid sm:grid-cols-2 gap-6">
                <div>
                  <div class="text-[12px] uppercase tracking-wider text-ink-400 font-semibold mb-2">{s.locations_page.detail_address}</div>
                  <ul class="space-y-3 text-[15px] text-ink-900">
                    {c.addresses.map((a, i) => {
                      const href = gisHref(c.slug, i);
                      return (
                        <li>
                          <div>{a}</div>
                          {href && (
                            <a href={href} target="_blank" rel="noopener" class="text-[13px] text-brand-700 hover:text-brand-800 hover:underline underline-offset-2">2ГИС →</a>
                          )}
                        </li>
                      );
                    })}
                  </ul>
                </div>

                <div>
                  <div class="text-[12px] uppercase tracking-wider text-ink-400 font-semibold mb-2">{s.locations_page.detail_phone}</div>
                  <a href={waHref(VOICE_ASSISTANT_WHATSAPP)} target="_blank" rel="noopener" class="block text-[16px] font-semibold text-ink-900 hover:text-brand-700">{VOICE_ASSISTANT_WHATSAPP}</a>

                  <div class="mt-5 text-[12px] uppercase tracking-wider text-ink-400 font-semibold mb-2">{s.locations_page.blood_draw_label}</div>
                  <ul class="space-y-1 text-[14px] text-ink-600">
                    <li>{s.locations_page.blood_draw_clinic}</li>
                    {c.slug === "astana" && <li>{s.locations_page.blood_draw_home}</li>}
                  </ul>
                </div>
              </div>
            </div>

            <!-- Facade photo: above the text on phones, right column on desktop -->
            <div class="relative bg-mist aspect-[4/3] lg:aspect-auto order-first lg:order-none">
              <img
                src={photo.src}
                srcset={`${photo.src} 1x, ${photo.src2x} 2x`}
                alt={photo.alt}
                class="absolute inset-0 w-full h-full object-cover"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      );
    })
  }
</section>

<!-- CTA -->
<section class="container-x pb-16 lg:pb-24">
  <div class="card p-8 lg:p-12 text-center reveal">
    <h3 class="mb-3">{s.contact_cta.title}</h3>
    <p class="text-ink-600 mb-6 max-w-prose mx-auto">{s.contact_cta.body}</p>
    <div class="flex flex-wrap gap-3 justify-center">
      <a href={waHref(VOICE_ASSISTANT_WHATSAPP)} target="_blank" rel="noopener" class="btn-primary">{s.contact_cta.cta_chat}</a>
      <a href={telHref(VOICE_ASSISTANT_PHONE)} class="btn-ghost">{s.contact_cta.cta_call} · {VOICE_ASSISTANT_PHONE}</a>
    </div>
  </div>
</section>
